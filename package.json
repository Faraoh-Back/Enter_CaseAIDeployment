{
  "name": "enter-case-ai-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preparação S0: execução Rivet, contratos e exportação verificável.",
  "engines": { "node": "20.20.2" },
  "scripts": {
    "s0:build": "node scripts/build-s0.mjs",
    "s0:check": "node scripts/check-s0.mjs",
    "s0:llm": "node --env-file=.env scripts/check-llm.mjs",
    "test": "npm run test:s0 && npm run test:s1 && npm run test:s1:grafo && npm run test:s1:xlsx && npm run test:s1:execucao && npm run test:s1:refatoracao && npm run test:s2",
    "test:s2:incertezas": "node tests/s2-incertezas.test.mjs",
    "test:s2": "node tests/s2-resultados.test.mjs",
    "test:s0": "node tests/s0.test.mjs",
    "test:s1:refatoracao": "node tests/s1-refatoracao.test.mjs",
    "test:s1": "node tests/s1.test.mjs",
    "s1:executar": "node scripts/executar-s1.mjs",
    "test:s1:execucao": "node tests/s1-execucao.test.mjs",
    "test:s1:xlsx": "node tests/s1-xlsx.test.mjs",
    "s1:build": "node scripts/build-s1.mjs",
    "test:s1:grafo": "node tests/s1-grafo.test.mjs",
    "s1:avaliar": "node --env-file=.env scripts/avaliar-s1.mjs"
  },
  "dependencies": {
    "@ironclad/rivet-node": "1.25.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.19.12"
  }
}
