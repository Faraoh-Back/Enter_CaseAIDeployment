# S0 usa OPENAI_API_KEY e, opcionalmente, LLM_MODEL. Demais campos são do fluxo futuro.
# Definir a chave apenas no ambiente local. Nunca incluir o valor no ZIP ou Git.
OPENAI_API_KEY=
# Snapshot testado na S0; qualidade completa de extração ainda será avaliada.
LLM_MODEL=gpt-4.1-mini-2025-04-14
HOST=127.0.0.1
PORT=3000
# Diretório contendo os cinco insumos; definir na preparação da primeira fatia.
INPUT_DIR=
# Cópia de trabalho; a prova S0 usa seu projeto separado em rivet/.
RIVET_PROJECT_PATH=rivet/analise_sentencas.rivet-project
RIVET_GRAPH=analisar_carteira
OUTPUT_DIR=outputs
REFERENCE_DATE=2026-05-31
LLM_CONCURRENCY=2
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=120000
RUN_TIMEOUT_MS=1800000
