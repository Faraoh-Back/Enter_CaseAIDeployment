# Configuração realmente utilizada pela CLI/API. Nunca versionar a chave.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini-2025-04-14
HOST=127.0.0.1
PORT=3000
# Opcional: pasta com os cinco insumos. Vazio localiza Input dentro de case/.
INPUT_DIR=
OUTPUT_DIR=outputs/api
# Grafo analisar_lote e data-base 2026-05-31 são definidos pelo case.
# Tentativas: 3 por sentença; timeout 10s/chamada, 40s/extração, 30min/carteira.
# Replay é configurado explicitamente por --replay --captura, sem carregar .env.
