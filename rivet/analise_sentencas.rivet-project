    s1_financeiro:
      metadata:
        description: 4. Calcular e decidir
        id: s1_financeiro
        name: s1_financeiro
      nodes:
        '[s1_calcular]:code "5. Calcular e decidir (BigInt)"':
          data:
            allowConsole: false
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >
              function calcularCondenacao(inputs) {

              // Executado dentro do Code Node; índices já escalados por 10.000.

              const p = inputs.parametros.value;

              for (const field of ['condenacao_centavos', 'meses',
              'probabilidade_percentual', 'custo_centavos']) {
                if (!Number.isSafeInteger(p[field]) || p[field] < 0) throw new Error(`Parametro invalido: ${field}`);
              }

              if (p.probabilidade_percentual > 100) throw new
              Error('Probabilidade maior que 100');

              for (const field of ['indice_base', 'indice_final']) {
                if (typeof p[field] !== 'string' || !/^[1-9][0-9]*$/.test(p[field])) throw new Error(`Indice invalido: ${field}`);
              }

              function rounded(n, d) {
                const sign = n < 0n ? -1n : 1n;
                const abs = n < 0n ? -n : n;
                const value = sign * (abs / d + (2n * (abs % d) >= d ? 1n : 0n));
                if (value > BigInt(Number.MAX_SAFE_INTEGER) || value < BigInt(Number.MIN_SAFE_INTEGER)) throw new Error('Inteiro inseguro');
                return Number(value);
              }

              const principalN = BigInt(p.condenacao_centavos) *
              BigInt(p.indice_final);

              const principalD = BigInt(p.indice_base);

              const totalN = principalN * (100n + BigInt(p.meses));

              const totalD = principalD * 100n;

              const principal = rounded(principalN, principalD);

              const total = rounded(totalN, totalD);

              const beneficioN = BigInt(p.probabilidade_percentual) *
              BigInt(total) - 100n * BigInt(p.custo_centavos);

              return { resultado: { type: 'object', value: {
                principal_corrigido_centavos: principal,
                juros_centavos: total - principal,
                valor_atualizado_centavos: total,
                beneficio_esperado_centavos: rounded(beneficioN, 100n),
                decisao_recurso: beneficioN > 0n ? 'recorrer' : 'nao_recorrer',
                memoria: {
                  principal_numerador: principalN.toString(), principal_denominador: principalD.toString(),
                  juros_numerador: (principalN * BigInt(p.meses)).toString(), juros_denominador: totalD.toString(),
                  total_numerador: totalN.toString(), total_denominador: totalD.toString(),
                  beneficio_numerador: beneficioN.toString(), beneficio_denominador: '100',
                  beneficio_residual_positivo: beneficioN > 0n && rounded(beneficioN, 100n) === 0,
                },
              } } };


              }

              // Vitória validada não passa pelas fórmulas de atualização ou
              benefício.

              // calcularCondenacao incorpora o Code Node financeiro S0 sem
              alterar suas regras.

              if (inputs.parametros.value.sem_condenacao === true) {
                return { resultado: { type: 'object', value: {
                  principal_corrigido_centavos: 0, juros_centavos: 0, valor_atualizado_centavos: 0,
                  beneficio_esperado_centavos: null, decisao_recurso: 'nao_recorrer', memoria: null,
                } } };
              }

              if (inputs.parametros.value.pendente) return
              {resultado:{type:'object',value:{
                principal_corrigido_centavos:null,juros_centavos:null,valor_atualizado_centavos:null,
                beneficio_esperado_centavos:null,decisao_recurso:'pendente',memoria:null}}};
              let resultado;

              try {resultado=calcularCondenacao(inputs);}

              catch(error) {
                if(error.message!=='Inteiro inseguro') throw error;
                return {resultado:{type:'object',value:{principal_corrigido_centavos:null,juros_centavos:null,valor_atualizado_centavos:null,
                  beneficio_esperado_centavos:null,decisao_recurso:'pendente',memoria:null,
                  falha_calculo:{codigo:'VALOR_FORA_INTERVALO',mensagem:'Cálculo excede o intervalo seguro de centavos; revisar antes de decidir.'}}}};
              }

              if (inputs.parametros.value.sem_decisao) {
                resultado.resultado.value.beneficio_esperado_centavos=null;
                resultado.resultado.value.decisao_recurso='pendente';
                for (const key of Object.keys(resultado.resultado.value.memoria)) if (key.startsWith('beneficio_')) delete resultado.resultado.value.memoria[key];
              }

              return resultado;
            inputNames:
              - parametros
            outputNames:
              - resultado
          outgoingConnections:
            - resultado->"resultado" s1_financeiro_out_resultado/value
          visualData: 440/0/320/null//
        '[s1_financeiro_in_parametros]:graphInput "parametros"':
          data:
            dataType: object
            id: parametros
            useDefaultValueInput: false
          outgoingConnections:
            - data->"5. Calcular e decidir (BigInt)" s1_calcular/parametros
          visualData: 0/0/320/null//
